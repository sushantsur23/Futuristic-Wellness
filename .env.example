# Application Configuration
PROJECT_NAME="Futuristic Wellness"
API_V1_STR="/api/v1"

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Database Connection URL
# SQLite Example: sqlite+aiosqlite:///backend/wellness.db
# PostgreSQL Example: postgresql+asyncpg://postgres:postgres@localhost:5432/futuristic_wellness
DATABASE_URL="sqlite+aiosqlite:///backend/wellness.db"

# JWT Authentication
JWT_SECRET="YOUR_SUPER_SECRET_JWT_KEY_PLEASE_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SMTP / Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@futuristicwellness.example"
EMAILS_FROM_NAME="Futuristic Wellness"

# Storage Directories
UPLOAD_DIR="static/uploads"

# Seeded Doctor Info
DOCTOR_EMAIL="doctor@futuristicwellness.example"
DOCTOR_PHONE="+10000000000"
DOCTOR_NAME="Dr Swandha Majumdar"
DOCTOR_SPECIALIZATION="Advanced Rehabilitation Specialist"
DOCTOR_REG_NUMBER="2010/05/PT/000486"
